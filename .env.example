# PostgreSQL
POSTGRES_DB=voicetalent
POSTGRES_USER=voicetalent
POSTGRES_PASSWORD=voicetalent_dev
POSTGRES_PORT=5432

# Backend (set PUBLIC_BASE_URL=https://vt-api.mana-matrix.com in production)
BACKEND_PORT=18080
PUBLIC_BASE_URL=http://localhost:18080
JPA_DDL_AUTO=update

# Set to true in production to enforce 2026-11-25 -> 2026-11-27 window
REGISTRATION_ENFORCE_WINDOW=false

# Storage: 'local' or 'supabase'
STORAGE_MODE=local
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=saas_attachments

# Admin Basic Auth
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123

# Cloudflare Turnstile
TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=

# Email
MAIL_ENABLED=false

# OpenAPI / Swagger UI (set false in production)
SWAGGER_ENABLED=true
